# Server
PORT=3000
HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API.
# Leave empty during local development to allow any origin.
# Example: https://your-app.vercel.app
CLIENT_ORIGIN=

# Supabase. Use the service role key on the server only. Never expose it to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI. The model only extracts inputs and narrates. Estimators compute every number.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
